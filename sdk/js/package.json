{
  "name": "letsfg",
  "version": "2026.5.73",
  "description": "Flights and hotels for AI agents. Server-side engine covers hundreds of airlines; hotels are real bookable inventory with free cancellation and pay-later terms. Includes open-source ranking engine.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "letsfg": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --clean",
    "test": "tsx --test src/index.test.ts src/auth.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "flights",
    "travel",
    "booking",
    "agent",
    "ai",
    "cli",
    "autonomous",
    "mcp",
    "openai",
    "airline",
    "ndc",
    "search",
    "ndc",
    "hotels",
    "hotel-booking",
    "hotel-search",
    "accommodation"
  ],
  "author": "LetsFG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LetsFG/LetsFG.git"
  },
  "homepage": "https://letsfg.co",
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
